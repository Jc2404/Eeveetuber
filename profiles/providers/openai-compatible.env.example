# Copy the settings you need into .env. Never commit a real API key.
EEVEETUBER_MODEL__PROVIDER=openai_compatible
EEVEETUBER_MODEL__BASE_URL=https://api.openai.com/v1
EEVEETUBER_MODEL__API_KEY=replace-me
EEVEETUBER_MODEL__MODEL=replace-with-an-available-chat-model

EEVEETUBER_SPEECH__PROVIDER=openai_compatible
EEVEETUBER_SPEECH__BASE_URL=https://api.openai.com/v1
EEVEETUBER_SPEECH__API_KEY=replace-me
EEVEETUBER_SPEECH__MODEL=gpt-4o-mini-tts
EEVEETUBER_SPEECH__VOICE=alloy
EEVEETUBER_SPEECH__RESPONSE_FORMAT=mp3

EEVEETUBER_ASR__PROVIDER=openai_compatible
EEVEETUBER_ASR__BASE_URL=https://api.openai.com/v1
EEVEETUBER_ASR__API_KEY=replace-me
EEVEETUBER_ASR__MODEL=whisper-1
EEVEETUBER_VOICE__ENABLED=true
