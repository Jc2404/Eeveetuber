# Copy the model lines into the project .env file to use an Ollama server that
# exposes its OpenAI-compatible endpoint. Replace the model with one installed
# locally (`ollama list`). No API key is sent.
EEVEETUBER_MODEL__PROVIDER=openai_compatible
EEVEETUBER_MODEL__BASE_URL=http://127.0.0.1:11434/v1
EEVEETUBER_MODEL__MODEL=replace-with-your-local-model

# Ollama does not provide the /audio/speech contract. Keep deterministic fake
# speech until a separate compatible TTS server is configured.
EEVEETUBER_SPEECH__PROVIDER=fake
